{
  "name": "spellbound-supply-co",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.worker.json && vite build",
    "dev:api": "wrangler dev --local --port 8787",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/libre-franklin": "latest",
    "@fontsource/playfair-display": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "jsdom": "^26.1.0",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.125.0"
  }
}
